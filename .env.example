##############################################################################
# HostPanel environment configuration
#
# Copy this file to .env (repo root) for local development with the
# docker-compose services, and fill in real secrets for any other
# environment. All variables are validated at startup by
# packages/shared/src/config — the app refuses to boot if a required
# variable is missing or malformed, rather than silently running with
# empty secrets.
##############################################################################

# --- Core -------------------------------------------------------------
NODE_ENV=development
# Public base URL of the web app (no trailing slash). Used for building
# absolute links in emails, webhooks, redirects, etc.
APP_URL=http://localhost:3000
# Human-readable name of the operator business. Never hardcode this in code.
APP_NAME="HostPanel"
# Default tenant slug created by the seed script (single-business deployment).
DEFAULT_TENANT_SLUG=default

# --- Database -----------------------------------------------------------
DATABASE_URL=postgresql://hostpanel:hostpanel@localhost:5432/hostpanel?schema=public
POSTGRES_USER=hostpanel
POSTGRES_PASSWORD=hostpanel
POSTGRES_DB=hostpanel
POSTGRES_PORT=5432

# --- Redis / queues -------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
# Port for the Bull Board queue-monitoring UI served by apps/worker.
BULL_BOARD_PORT=3001

# --- Auth -----------------------------------------------------------------
# Random 32+ byte secret used to sign session/CSRF tokens. Generate with:
#   openssl rand -base64 48
AUTH_SECRET=
# Symmetric key (32 bytes, base64) used to encrypt sensitive-at-rest fields
# (TOTP secrets, registrar EPP codes, etc.). Generate with:
#   openssl rand -base64 32
ENCRYPTION_KEY=
# Comma-separated list of staff emails that must have 2FA enabled to log in.
# Use "*" to require 2FA for all staff accounts.
STAFF_REQUIRE_2FA=

# --- Email ------------------------------------------------------------
# "resend" or "smtp". See ENVIRONMENT.md for the tradeoffs.
EMAIL_PROVIDER=smtp
EMAIL_FROM="HostPanel <no-reply@example.com>"
RESEND_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# --- Object storage (S3-compatible: AWS S3, Cloudflare R2, MinIO, Wasabi) --
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=hostpanel-files
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=false

# --- Error tracking / observability ----------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# --- Payments (Phase 2) -----------------------------------------------------
# Left blank until Phase 2 is implemented. When empty, checkout falls back to
# the manual bank-transfer payment method rather than pretending Stripe is
# configured. See ARCHITECTURE.md "Integration adapters".
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- Domains / registrar (Phase 4) ------------------------------------------
# Which registrar adapter to load. "manual" is always available and is the
# default until a real registrar account + credentials are chosen.
REGISTRAR_PROVIDER=manual
REGISTRAR_API_KEY=
REGISTRAR_API_SECRET=
REGISTRAR_SANDBOX=true

# --- Hosting provisioning (Phase 3) -----------------------------------------
# Which control panel adapter to load by default for new servers. "manual" is
# always available regardless of this setting; individual Server records can
# override it once real panel credentials exist.
PROVISIONING_DEFAULT_DRIVER=manual
